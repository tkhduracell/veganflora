rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Recipe photos, shown to anyone browsing the recipe list
    match /images/{image} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Temporary uploads for the AI recipe import. The importImage function
    // reads them with the admin SDK (which bypasses these rules) and deletes
    // them afterwards, so only the uploading user needs access.
    match /imports/{file} {
      allow read, write: if request.auth != null;
    }
  }
}
